<!doctype html>
<html lang="{{ page.lang | default: site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <script>
      (() => {
        const storageKey = "theme";
        const legacyKey = "theme-preference";
        const normalizeThemeSetting = (value) => value === "light" || value === "dark" || value === "system" ? value : "system";
        const savedThemeSetting = normalizeThemeSetting(localStorage.getItem(storageKey) || localStorage.getItem(legacyKey));
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const computedTheme = savedThemeSetting === "system" ? (prefersDark ? "dark" : "light") : savedThemeSetting;
        document.documentElement.dataset.theme = computedTheme;
        document.documentElement.dataset.themeSetting = savedThemeSetting;
      })();
    </script>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = '/' | relative_url %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% assign display_name = page.display_name | default: site.title %}
    {% assign home_url = page.home_url | default: '/' %}
    <title>{% if page.title and page.title != 'home' %}{{ page.title }} | {% endif %}{{ display_name }}</title>
    <meta name="description" content="{{ page.description | default: site.description }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/bootstrap.min.css' | relative_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">
  </head>
  <body>
    {% unless page.hide_site_header %}
      <header class="site-header py-3 mb-5">
        <div class="container">
          <div class="site-header-inner{% if page.hide_header_title %} site-header-inner-no-title{% endif %}">
            {% unless page.hide_header_title %}
              <a class="site-title h4 m-0 text-decoration-none" href="{{ home_url | relative_url }}">{{ display_name }}</a>
            {% endunless %}
            <div class="site-actions">
              {% include language_switch.liquid %}
              {% include theme_toggle.liquid %}
            </div>
          </div>
        </div>
      </header>
    {% endunless %}

    <main class="container pb-5" role="main">
      {{ content }}
    </main>
    <script>
      (() => {
        const storageKey = "theme";
        const legacyKey = "theme-preference";
        const root = document.documentElement;
        const toggle = document.getElementById("light-toggle");
        const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
        if (!toggle) return;

        const normalizeThemeSetting = (value) => value === "light" || value === "dark" || value === "system" ? value : "system";
        const determineThemeSetting = () => normalizeThemeSetting(localStorage.getItem(storageKey) || localStorage.getItem(legacyKey));
        const determineComputedTheme = (themeSetting) => themeSetting === "system" ? (mediaQuery.matches ? "dark" : "light") : themeSetting;

        const applyTheme = (themeSetting) => {
          root.dataset.themeSetting = themeSetting;
          root.dataset.theme = determineComputedTheme(themeSetting);
          toggle.setAttribute("title", `Change theme (${themeSetting})`);
          toggle.setAttribute("aria-label", `Change theme (${themeSetting})`);
        };

        const cycleThemeSetting = (themeSetting) => {
          if (themeSetting === "system") return "light";
          if (themeSetting === "light") return "dark";
          return "system";
        };

        toggle.addEventListener("click", () => {
          const nextThemeSetting = cycleThemeSetting(root.dataset.themeSetting || determineThemeSetting());
          localStorage.setItem(storageKey, nextThemeSetting);
          localStorage.removeItem(legacyKey);
          applyTheme(nextThemeSetting);
        });

        if (typeof mediaQuery.addEventListener === "function") {
          mediaQuery.addEventListener("change", () => {
            if ((root.dataset.themeSetting || determineThemeSetting()) === "system") {
              applyTheme("system");
            }
          });
        } else if (typeof mediaQuery.addListener === "function") {
          mediaQuery.addListener(() => {
            if ((root.dataset.themeSetting || determineThemeSetting()) === "system") {
              applyTheme("system");
            }
          });
        }

        applyTheme(determineThemeSetting());
      })();
    </script>
  </body>
</html>
